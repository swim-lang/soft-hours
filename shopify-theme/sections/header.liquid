{% assign primary_menu = section.settings.primary_menu %}
{% assign secondary_menu = section.settings.secondary_menu %}
{% assign journal = blogs['founders-journal'] | default: blogs['journal'] %}
{% assign about_page = pages['about'] %}
{% assign about_url = section.settings.about_review_url %}
{% if about_page != blank %}{% assign about_url = about_page.url %}{% endif %}
<header class="nav{% if template.name == 'index' %} nav--hero{% endif %}" data-site-header>
  <div class="nav-side nav-left"><a class="wordmark-nav" href="{{ routes.root_url }}" aria-label="{{ shop.name }}"></a></div>
  <nav class="nav-links" aria-label="Primary">
    {% if primary_menu != blank %}
      {% for link in primary_menu.links %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}
    {% else %}
      <a href="{{ routes.collections_url }}/collection-i">Shop</a><a href="{% if journal != blank %}{{ journal.url }}{% else %}{{ routes.root_url }}#JournalPreview{% endif %}">Journal</a><a href="{{ about_url }}">About</a>
    {% endif %}
  </nav>
  <div class="nav-side nav-right">
    {% form 'localization', class: 'nav-localization' %}
      <label class="visually-hidden" for="HeaderCountry">Country and currency</label>
      <select id="HeaderCountry" name="country_code" data-localization-select aria-label="Country and currency">
        {% for country in localization.available_countries %}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} — {{ country.currency.iso_code }}</option>{% endfor %}
      </select>
    {% endform %}
    <button class="nav-action" type="button" aria-controls="CartDrawer" aria-expanded="false" data-open-cart>Cart (<span data-cart-count>{{ cart.item_count }}</span>)</button>
  </div>
  <button class="nav-burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="MobileMenu" data-open-menu><span></span><span></span></button>
</header>
<div class="mobile-menu" id="MobileMenu" aria-hidden="true" data-mobile-menu>
  <div class="mobile-menu-head"><span>{{ settings.brand_name | default: shop.name }}</span><button class="mobile-menu-close" type="button" data-close-menu>Close ×</button></div>
  <nav class="mobile-menu-links" aria-label="Mobile primary">
    {% if primary_menu != blank %}{% for link in primary_menu.links %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}
    {% else %}<a href="{{ routes.collections_url }}/collection-i">Shop</a><a href="{% if journal != blank %}{{ journal.url }}{% else %}{{ routes.root_url }}#JournalPreview{% endif %}">Journal</a><a href="{{ about_url }}">About</a>{% endif %}
    {% if secondary_menu != blank %}{% for link in secondary_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% endif %}
  </nav>
  <div class="mobile-menu-meta">
    {% form 'localization', class: 'mobile-localization' %}
      <label class="visually-hidden" for="MobileCountry">Country and currency</label>
      <select id="MobileCountry" name="country_code" data-localization-select aria-label="Country and currency">
        {% for country in localization.available_countries %}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} — {{ country.currency.iso_code }}</option>{% endfor %}
      </select>
    {% endform %}
    <button type="button" data-open-cart>Cart (<span data-cart-count>{{ cart.item_count }}</span>)</button>
  </div>
</div>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "paragraph", "content": "The approved Soft Hours wordmark and navigation styling are fixed. Manage links in Content > Menus." },
    { "type": "link_list", "id": "primary_menu", "label": "Primary menu" },
    { "type": "link_list", "id": "secondary_menu", "label": "Mobile-only secondary menu" },
    { "type": "text", "id": "about_review_url", "label": "About link", "default": "/pages/contact-1?view=about-review", "info": "Staging route while the About page is unpublished. Change to /pages/about before launch." }
  ]
}
{% endschema %}
