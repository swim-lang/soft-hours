<section class="home-hero">
  <div class="home-hero__media home-hero__media--desktop{% if section.settings.mobile_image %} has-mobile{% endif %}">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: preload: true, widths: '750, 1100, 1600, 2000, 2400', sizes: '100vw', alt: section.settings.image_alt | default: section.settings.image.alt | default: section.settings.heading }}
    {% else %}
      <img src="{{ 'hero-time-well-kept.jpg' | asset_url }}" width="6720" height="4480" alt="{{ section.settings.heading | escape }}" fetchpriority="high">
    {% endif %}
  </div>
  {% if section.settings.mobile_image %}<div class="home-hero__media home-hero__media--mobile">{{ section.settings.mobile_image | image_url: width: 1200 | image_tag: preload: true, widths: '480, 750, 1000, 1200', sizes: '100vw', alt: section.settings.image_alt | default: section.settings.mobile_image.alt | default: section.settings.heading }}</div>{% endif %}
  <div class="home-hero__content">
    <div>
      <h1>{{ section.settings.heading }}</h1>
      {% if section.settings.subheading != blank %}<p>{{ section.settings.subheading }}</p>{% endif %}
    </div>
    {% if section.settings.link_label != blank %}<a class="home-hero__cta" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Home hero",
  "settings": [
    { "type": "header", "content": "Photography" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Optional. Uses the desktop image when blank." },
    { "type": "text", "id": "image_alt", "label": "Image description", "info": "Describe the photograph for customers using screen readers." },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "TIME WELL KEPT" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pyjamas for morning, evening, and the hours between." },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Shop Collection I" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [{ "name": "Home hero" }]
}
{% endschema %}
