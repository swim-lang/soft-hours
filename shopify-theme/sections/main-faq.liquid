<header class="page-hero">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h1>{{ section.settings.heading }}</h1>
  <nav class="support-nav" aria-label="Support pages">
    {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
  </nav>
</header>
<section class="page-shell support-layout">
  <div>
    <h2 class="display">{{ section.settings.list_heading }}</h2>
    <div class="accordion-list">
      {% for block in section.blocks %}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="rte">{{ block.settings.answer }}</div>
        </details>
      {% else %}
        <p class="rte">Approved answers can be added here when product and operational details are confirmed.</p>
      {% endfor %}
    </div>
  </div>
  <aside>
    <p class="eyebrow">{{ section.settings.help_eyebrow }}</p>
    <h2 class="display">{{ section.settings.help_heading }}</h2>
    {% if settings.support_email != blank %}<a class="text-link" href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a>{% endif %}
    {% if section.settings.contact_url != blank %}<p><a class="text-link" href="{{ section.settings.contact_url }}">Contact us</a></p>{% endif %}
  </aside>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "paragraph", "content": "Add, edit, reorder, or remove questions using the blocks below. Keep policy answers provisional until operations are approved." },
    { "type": "text", "id": "eyebrow", "label": "Page eyebrow", "default": "Support" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How Can We Help?" },
    { "type": "text", "id": "list_heading", "label": "Question-list heading", "default": "Frequently asked questions" },
    { "type": "link_list", "id": "menu", "label": "Support menu" },
    { "type": "header", "content": "Help prompt" },
    { "type": "text", "id": "help_eyebrow", "label": "Eyebrow", "default": "Still need help?" },
    { "type": "text", "id": "help_heading", "label": "Heading", "default": "We're Here." },
    { "type": "url", "id": "contact_url", "label": "Contact link" }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" }
    ], "limit": 16 }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
