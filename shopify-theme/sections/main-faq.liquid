<header class="page-hero">
  <p class="eyebrow">Support</p>
  <h1>{{ section.settings.heading }}</h1>
  <nav class="support-nav" aria-label="Support pages">
    {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
  </nav>
</header>
<section class="page-shell support-layout">
  <div>
    <h2 class="display">Frequently asked questions</h2>
    <div class="accordion-list">
      {% for block in section.blocks %}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="rte">{{ block.settings.answer }}</div>
        </details>
      {% else %}
        <p class="rte">Approved answers can be added here when product and operational details are confirmed.</p>
      {% endfor %}
    </div>
  </div>
  <aside>
    <p class="eyebrow">Still need help?</p>
    <h2 class="display">WE'RE HERE.</h2>
    {% if settings.support_email != blank %}<a class="text-link" href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a>{% endif %}
    {% if section.settings.contact_url != blank %}<p><a class="text-link" href="{{ section.settings.contact_url }}">Contact us</a></p>{% endif %}
  </aside>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "HOW CAN WE HELP?" },
    { "type": "link_list", "id": "menu", "label": "Support menu" },
    { "type": "url", "id": "contact_url", "label": "Contact link" }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" }
    ] }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
