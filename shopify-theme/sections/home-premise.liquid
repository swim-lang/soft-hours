<section class="home-premise">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h2>{{ section.settings.heading }}</h2>
  {% if section.settings.body != blank %}<div class="rte">{{ section.settings.body }}</div>{% endif %}
</section>

{% schema %}
{
  "name": "Home premise",
  "settings": [
    { "type": "paragraph", "content": "The short brand statement immediately after the hero." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Soft Hours" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FOR THE FIRST HOUR AND THE LAST" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>The day belongs to many things. Soft Hours is made for the moments a woman keeps for herself.</p>" }
  ],
  "presets": [{ "name": "Home premise" }]
}
{% endschema %}
