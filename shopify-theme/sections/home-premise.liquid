<section class="home-intro">
  <h2 class="home-intro-title">{{ section.settings.heading }}</h2>
  {% if section.settings.body != blank %}<div class="home-intro-body">{{ section.settings.body }}</div>{% endif %}
</section>
{% schema %}
{
  "name": "Making introduction",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made with Patience" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>A piece can only feel considered if it is made that way. Soft Hours approaches fabric development, sampling, fit, and finishing with care over speed. Final material and maker details will be shared once they are approved.</p>" }
  ],
  "presets": [{ "name": "Making introduction" }]
}
{% endschema %}
