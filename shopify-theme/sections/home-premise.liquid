<section class="home-premise">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h2>{{ section.settings.heading }}</h2>
  {% if section.settings.body != blank %}<p>{{ section.settings.body }}</p>{% endif %}
</section>

{% schema %}
{
  "name": "Home premise",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Soft Hours" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FOR THE FIRST HOUR AND THE LAST" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "The day belongs to many things. Soft Hours is made for the moments a woman keeps for herself." }
  ],
  "presets": [{ "name": "Home premise" }]
}
{% endschema %}
