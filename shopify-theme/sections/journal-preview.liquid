{% assign journal = section.settings.blog %}
<section class="journal-preview">
  <div class="journal-preview__intro">
    <p class="eyebrow">Journal</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>
  <div class="journal-grid">
    {% if journal != blank and journal.articles_count > 0 %}
      {% for article in journal.articles limit: 3 %}
        <a class="journal-card" href="{{ article.url }}">
          <div class="journal-card__image">
            {% if article.image %}{{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 600, 900, 1000', sizes: '(min-width: 901px) 33vw, 100vw', alt: article.image.alt | default: article.title }}{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}
          </div>
          <div class="journal-card__meta"><span>Journal</span><span>{{ article.published_at | date: '%d.%m.%y' }}</span></div>
          <h3>{{ article.title }}</h3>
        </a>
      {% endfor %}
    {% else %}
      {% assign fallback_titles = 'Home|Urban Landscape|Soft Landscape' | split: '|' %}
      {% assign fallback_assets = 'journal-home.jpg|journal-urban.jpg|journal-soft.jpg' | split: '|' %}
      {% for title in fallback_titles %}
        <article class="journal-card">
          <div class="journal-card__image">{{ fallback_assets[forloop.index0] | asset_url | image_tag: loading: 'lazy', alt: title }}</div>
          <div class="journal-card__meta"><span>Working editorial</span><span>0{{ forloop.index }}</span></div>
          <h3>{{ title }}</h3>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Journal preview",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Journal blog" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "AS SHE PLEASES" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Notes on home, place, and the quiet rituals that make time feel like your own." }
  ],
  "presets": [{ "name": "Journal preview" }]
}
{% endschema %}
