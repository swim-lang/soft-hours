{% assign journal = section.settings.blog %}
<section class="home-journal" id="JournalPreview">
  <div class="home-journal-head"><div class="home-journal-eyebrow"><span class="line"></span><span>{{ section.settings.eyebrow }}</span><span class="line"></span></div><h2 class="home-journal-title">{{ section.settings.heading }}</h2><p class="home-journal-sub">{{ section.settings.subheading }}</p></div>
  <div class="home-triptych">
    {% if journal != blank and journal.articles_count > 0 %}
      {% for article in journal.articles limit: 3 %}<a class="home-world" href="{{ article.url }}"><div class="home-world-img"{% if article.image %} style="background-image:url({{ article.image | image_url: width: 1200 }})"{% endif %}></div><div class="home-world-info"><div class="home-world-meta"><span>World {% case forloop.index %}{% when 1 %}I{% when 2 %}II{% else %}III{% endcase %}</span><span>№ 0{{ forloop.index }}</span></div><div class="home-world-name">{{ article.title }}</div><div class="home-world-body">{{ article.excerpt_or_content | strip_html | truncate: 150 }}</div></div></a>{% endfor %}
    {% else %}
      {% assign titles = 'Home|Urban landscape|Soft landscape' | split: '|' %}{% assign images = '01KV63THF88XNMH3YZCEEPHWRC.png|01KV63T6G65ZWKXMFAPFXTPT4H.png|01KV63VEK16QTR9X8JRHSPT2NS.png' | split: '|' %}{% assign summaries = 'A balcony, a curtain, the kettle in the kitchen — the rooms a woman keeps for herself.|A street in last light, a window open above a courtyard, the city catching its breath.|Long grass and shoreline, the air still cool — the slow openings of a day.' | split: '|' %}
      {% for title in titles %}<article class="home-world"><div class="home-world-img" style="background-image:url({{ images[forloop.index0] | asset_url }})"></div><div class="home-world-info"><div class="home-world-meta"><span>World {% case forloop.index %}{% when 1 %}I{% when 2 %}II{% else %}III{% endcase %}</span><span>№ 0{{ forloop.index }}</span></div><div class="home-world-name">{{ title }}</div><div class="home-world-body">{{ summaries[forloop.index0] }}</div></div></article>{% endfor %}
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Journal preview",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Journal blog" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "As She Pleases" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Notes on travel, interiors, and the art of staying in." }
  ],
  "presets": [{ "name": "Journal preview" }]
}
{% endschema %}
