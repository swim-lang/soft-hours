<section class="home-proof">
  <div class="home-proof-image"{% if section.settings.image %} style="background-image:url({{ section.settings.image | image_url: width: 1800 }})"{% endif %} role="img" aria-label="{{ section.settings.image_alt | escape }}"></div>
  <div class="home-proof-copy">
    <p class="home-proof-status">{{ section.settings.status }}</p><h2>{{ section.settings.heading }}</h2><p class="home-proof-intro">{{ section.settings.introduction }}</p>
    <dl class="home-proof-list">
      {% for block in section.blocks %}<div {{ block.shopify_attributes }}><dt>{{ block.settings.label }}</dt><dd>{{ block.settings.body }}</dd></div>{% endfor %}
    </dl>
  </div>
</section>
{% schema %}
{
  "name": "Fabric and making",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "Soft green fabric being cut during garment development" },
    { "type": "text", "id": "status", "label": "Status line", "default": "Content direction · Pending final sample and maker approval" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FABRIC & MAKING" },
    { "type": "textarea", "id": "introduction", "label": "Introduction", "default": "The final store can make the quality tangible without turning Soft Hours into a performance-led fabric brand." }
  ],
  "blocks": [{ "type": "fact", "name": "Making detail", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Material direction" }, { "type": "textarea", "id": "body", "label": "Body", "default": "Final details will be added once approved." }] }],
  "presets": [{ "name": "Fabric and making", "blocks": [{ "type": "fact", "settings": { "label": "Material direction", "body": "A double-satin silk and modal blend is in development. Final composition follows sample approval." } }, { "type": "fact", "settings": { "label": "Tested through sampling", "body": "Blend, fit, fall, finish, and care remain editable until final review." } }, { "type": "fact", "settings": { "label": "Maker proof", "body": "Verified maker and production-location details can be added once confirmed." } }] }]
}
{% endschema %}
