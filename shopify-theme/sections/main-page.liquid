<header class="page-hero">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h1>{{ page.title }}</h1>
</header>
<section class="page-shell">
  <div class="policy-content rte">{{ page.content }}</div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [{ "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Soft Hours" }]
}
{% endschema %}
