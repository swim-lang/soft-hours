<header class="page-hero"><p class="eyebrow">Customer account</p><h1>Addresses</h1></header>
<section class="page-shell support-layout">
  <div>
    <h2 class="display">Saved Addresses</h2>
    <div class="account-orders">
      {% for address in customer.addresses %}
        <div class="account-address">
          <div class="rte">{{ address | format_address }}</div>
          {% if address == customer.default_address %}<span class="eyebrow">Default</span>{% endif %}
          <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}"><input type="hidden" name="_method" value="delete"><button class="button-reset text-link" type="submit">Remove</button></form>
        </div>
      {% else %}
        <p class="rte">No saved addresses.</p>
      {% endfor %}
    </div>
  </div>
  <aside class="contact-form">
    <p class="eyebrow">New address</p>
    {% form 'customer_address', customer.new_address %}
      <div class="field"><label for="AddressFirstName">First name</label><input id="AddressFirstName" type="text" name="address[first_name]" autocomplete="given-name"></div>
      <div class="field"><label for="AddressLastName">Last name</label><input id="AddressLastName" type="text" name="address[last_name]" autocomplete="family-name"></div>
      <div class="field"><label for="AddressCompany">Company</label><input id="AddressCompany" type="text" name="address[company]" autocomplete="organization"></div>
      <div class="field"><label for="AddressLine1">Address</label><input id="AddressLine1" type="text" name="address[address1]" autocomplete="address-line1" required></div>
      <div class="field"><label for="AddressLine2">Address line 2</label><input id="AddressLine2" type="text" name="address[address2]" autocomplete="address-line2"></div>
      <div class="field"><label for="AddressCity">City</label><input id="AddressCity" type="text" name="address[city]" autocomplete="address-level2" required></div>
      <div class="field"><label for="AddressCountry">Country</label><select id="AddressCountry" name="address[country]" data-default="{{ form.country }}">{{ all_country_option_tags }}</select></div>
      <div class="field"><label for="AddressZip">Postal code</label><input id="AddressZip" type="text" name="address[zip]" autocomplete="postal-code" required></div>
      <div class="field"><label for="AddressPhone">Phone</label><input id="AddressPhone" type="tel" name="address[phone]" autocomplete="tel"></div>
      <button class="button button--dark" type="submit">Add address</button>
    {% endform %}
    <p><a class="text-link" href="{{ routes.account_url }}">Back to account</a></p>
  </aside>
</section>

{% schema %}{ "name": "Addresses", "settings": [] }{% endschema %}
