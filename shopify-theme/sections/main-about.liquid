<section class="about-clock">
  <div class="about-clock__dial" aria-hidden="true">
    <div class="about-clock__face"></div>
    <span class="clock-hand clock-hand--hour"></span>
    <span class="clock-hand clock-hand--minute"></span>
  </div>
  <h1>{{ section.settings.hero_heading | newline_to_br }}</h1>
</section>

{% for block in section.blocks %}
  <section class="about-section about-section--{{ block.settings.image_side }}" {{ block.shopify_attributes }}>
    <div class="about-section__media">
      {% if block.settings.image %}
        <div class="about-section__image about-section__image--desktop{% if block.settings.mobile_image %} has-mobile{% endif %}">{{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 750, 1000, 1400, 1600', sizes: '(min-width: 901px) 50vw, 100vw', alt: block.settings.image_alt | default: block.settings.image.alt | default: block.settings.heading }}</div>
      {% elsif forloop.first %}
        <img src="{{ 'founder.jpg' | asset_url }}" width="510" height="768" alt="{{ block.settings.heading | escape }}" loading="lazy">
      {% else %}
        <img src="{{ 'bedspread.jpg' | asset_url }}" width="4421" height="2498" alt="{{ block.settings.heading | escape }}" loading="lazy">
      {% endif %}
      {% if block.settings.mobile_image %}<div class="about-section__image about-section__image--mobile">{{ block.settings.mobile_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '480, 750, 1000', sizes: '100vw', alt: block.settings.image_alt | default: block.settings.mobile_image.alt | default: block.settings.heading }}</div>{% endif %}
      {% if block.settings.caption != blank %}<p class="about-section__caption">{{ block.settings.caption }}</p>{% endif %}
    </div>
    <div class="about-section__copy">
      <p class="eyebrow">{{ block.settings.eyebrow }}</p>
      <h2>{{ block.settings.heading }}</h2>
      <div class="rte">{{ block.settings.body }}</div>
    </div>
  </section>
{% endfor %}

{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "paragraph", "content": "The clock remains part of the design. Edit its headline here, then edit or reorder the story blocks below." },
    { "type": "textarea", "id": "hero_heading", "label": "Hero heading", "default": "FOR THE FIRST\nHOUR &\nTHE LAST" }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "story",
      "name": "Story section",
      "settings": [
        { "type": "header", "content": "Photography" },
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Optional. Uses the desktop image when blank." },
        { "type": "text", "id": "image_alt", "label": "Image description" },
        { "type": "text", "id": "caption", "label": "Optional caption" },
        { "type": "select", "id": "image_side", "label": "Desktop image position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
        { "type": "header", "content": "Copy" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Soft Hours" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "COMING HOME TO YOURSELF" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Soft Hours began with a belief that the hours around the day deserve their own kind of care.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "About", "blocks": [{ "type": "story" }, { "type": "story" }] }]
}
{% endschema %}
