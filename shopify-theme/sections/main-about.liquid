<section class="about-clock">
  <div class="about-clock__dial" aria-hidden="true">
    <div class="about-clock__face"></div>
    <span class="clock-hand clock-hand--hour"></span>
    <span class="clock-hand clock-hand--minute"></span>
  </div>
  <h1>{{ section.settings.hero_heading | newline_to_br }}</h1>
</section>

{% for block in section.blocks %}
  <section class="about-section" {{ block.shopify_attributes }}>
    <div class="about-section__media">
      {% if block.settings.image %}
        {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 750, 1000, 1400, 1600', sizes: '(min-width: 901px) 50vw, 100vw', alt: block.settings.image.alt | default: block.settings.heading }}
      {% elsif forloop.first %}
        {{ 'founder.jpg' | asset_url | image_tag: loading: 'lazy', alt: block.settings.heading }}
      {% else %}
        {{ 'bedspread.jpg' | asset_url | image_tag: loading: 'lazy', alt: block.settings.heading }}
      {% endif %}
    </div>
    <div class="about-section__copy">
      <p class="eyebrow">{{ block.settings.eyebrow }}</p>
      <h2>{{ block.settings.heading }}</h2>
      <div class="rte">{{ block.settings.body }}</div>
    </div>
  </section>
{% endfor %}

{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "textarea", "id": "hero_heading", "label": "Hero heading", "default": "FOR THE FIRST\nHOUR &\nTHE LAST" }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story section",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Soft Hours" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "COMING HOME TO YOURSELF" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Soft Hours began with a belief that the hours around the day deserve their own kind of care.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "About", "blocks": [{ "type": "story" }, { "type": "story" }] }]
}
{% endschema %}
