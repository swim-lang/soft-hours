<div class="about-v2">
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-circle" aria-hidden="true"><div class="clock-face"></div><span class="clock-hand clock-hand--hour"></span><span class="clock-hand clock-hand--minute"></span></div>
      <h1 class="hero-title">{{ section.settings.hero_heading }}</h1>
    </div>
  </section>

  <section class="intro">
    <p class="eyebrow-link">{{ section.settings.intro_eyebrow }}</p>
    <div class="intro-body">{{ section.settings.intro_body }}</div>
  </section>

  <section class="bedspread"{% if section.settings.bedspread_image %} style="background-image:url('{{ section.settings.bedspread_image | image_url: width: 2400 }}')"{% endif %}>
    <div class="bedspread-overlay"></div>
    <div class="bedspread-content"><div class="label-row"><span class="line"></span><span class="label">{{ section.settings.bedspread_label }}</span><span class="line"></span></div><h2 class="bedspread-title">{{ section.settings.bedspread_heading }}</h2></div>
  </section>

  <section class="founder">
    <div class="founder-text"><h2 class="founder-title">{{ section.settings.founder_heading }}</h2><div class="founder-body">{{ section.settings.founder_body }}</div></div>
    <div class="founder-image"{% if section.settings.founder_image %} style="background-image:url('{{ section.settings.founder_image | image_url: width: 1600 }}')"{% endif %} role="img" aria-label="{{ section.settings.founder_image_alt | escape }}"></div>
  </section>

  <section class="patience">
    <div class="patience-header"><h2 class="patience-title">{{ section.settings.patience_heading }}</h2><div class="patience-body">{{ section.settings.patience_body }}</div></div>
    <div class="maker-grid">
      {% for block in section.blocks %}
        <article class="maker" {{ block.shopify_attributes }}>
          {% if block.settings.image %}<div class="maker-image" style="background-image:url('{{ block.settings.image | image_url: width: 1400 }}');background-position:{{ block.settings.image_position }};background-size:cover" role="img" aria-label="{{ block.settings.image_alt | escape }}"></div>{% else %}<div class="maker-image {{ block.settings.fallback_image }}" role="img" aria-label="{{ block.settings.image_alt | escape }}"></div>{% endif %}
          <div class="maker-text"><p class="maker-caption">{{ block.settings.caption }}</p><h3 class="maker-name">{{ block.settings.heading }}</h3><div class="maker-body">{{ block.settings.body }}</div></div>
        </article>
      {% endfor %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "paragraph", "content": "The approved clock-led About design is preserved here. Images and copy remain editable; verify all maker and production claims before publication." },
    { "type": "inline_richtext", "id": "hero_heading", "label": "Hero heading", "default": "FOR THE FIRST HOUR & THE LAST" },
    { "type": "text", "id": "intro_eyebrow", "label": "Introduction eyebrow", "default": "WHERE WE'RE COMING FROM" },
    { "type": "richtext", "id": "intro_body", "label": "Introduction", "default": "<p>Soft Hours is built around a single idea: what you wear when you enter and exit the day should be treated with care, intention, and patience.</p><p>These are not pieces for sleep alone; they are part of how you enter and leave the day. The first hour and the last. They change the feeling of the hour and make the beginning and end of your day more conscious.</p>" },
    { "type": "header", "content": "Time well kept image" },
    { "type": "image_picker", "id": "bedspread_image", "label": "Image" },
    { "type": "text", "id": "bedspread_label", "label": "Label", "default": "For Chosen Solitude" },
    { "type": "text", "id": "bedspread_heading", "label": "Heading", "default": "TIME WELL KEPT" },
    { "type": "header", "content": "Founder" },
    { "type": "image_picker", "id": "founder_image", "label": "Founder image" },
    { "type": "text", "id": "founder_image_alt", "label": "Founder image description", "default": "Founder in a meadow" },
    { "type": "text", "id": "founder_heading", "label": "Founder heading", "default": "OUR FOUNDER" },
    { "type": "richtext", "id": "founder_body", "label": "Founder story", "default": "<p>Soft Hours started with a frustration that we just couldn't shake. Our founder, Marion Voldan, had spent several years in the apparel industry surrounded by beautiful cloth made into clothes for going out. Pieces meant for home were always an afterthought: thin, disposable, made down to a cheap price that reflected the lack of quality.</p><p>The hours at the edges of the day are some of our most honest, so she set out to make the thing that did not exist: clothing for the private hours, approached with the same intention as everything worn beyond the front door.</p>" },
    { "type": "header", "content": "Making" },
    { "type": "text", "id": "patience_heading", "label": "Making heading", "default": "MADE WITH PATIENCE" },
    { "type": "richtext", "id": "patience_body", "label": "Making introduction", "default": "<p>A piece can only feel considered if it is made that way. Fabric development, sampling, fit, and finishing are still in progress. Final maker and production-location details will be added once they are confirmed.</p>" }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "maker",
      "name": "Making item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "fallback_image", "label": "Preview fallback image", "options": [{ "value": "brick", "label": "Brick mill" }, { "value": "fabric", "label": "Fabric" }, { "value": "office", "label": "Studio" }], "default": "brick" },
        { "type": "text", "id": "image_position", "label": "Image position", "default": "50% 30%" },
        { "type": "text", "id": "image_alt", "label": "Image description" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Development · In progress" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "A CONSIDERED PROCESS" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Final details will be published only after they are approved.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "About", "blocks": [{ "type": "maker", "settings": { "fallback_image": "brick", "caption": "Fabric development · In progress", "heading": "DOUBLE-SATIN BLEND" } }, { "type": "maker", "settings": { "fallback_image": "fabric", "caption": "Garment sampling · In progress", "heading": "FIT, FALL, AND FINISH" } }, { "type": "maker", "settings": { "fallback_image": "office", "caption": "Identity and direction · Soft Hours", "heading": "TIME WELL KEPT" } }] }]
}
{% endschema %}
