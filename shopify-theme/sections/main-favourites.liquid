<div class="collection-v2 favourites-page" data-favourites-page>
  <section class="shop-head">
    <div class="shop-eyebrow"><span class="line"></span><span>{{ section.settings.eyebrow }}</span><span class="line"></span></div>
    <h1 class="shop-title">{{ section.settings.heading }}</h1>
    {% if section.settings.intro != blank %}<p class="shop-intro">{{ section.settings.intro }}</p>{% endif %}
  </section>

  <p class="favourites-status" data-favourites-status role="status" aria-live="polite">Loading your favourites…</p>
  <section class="shop-grid favourites-grid" data-favourites-grid aria-label="{{ section.settings.heading | escape }}"></section>

  <div class="favourites-empty" data-favourites-empty hidden>
    <h2>{{ section.settings.empty_heading }}</h2>
    <p>{{ section.settings.empty_body }}</p>
    <a class="prototype-button" href="{{ section.settings.empty_link | default: '/collections/collection-i' }}">{{ section.settings.empty_link_label }}</a>
  </div>
  <noscript><p class="favourites-status">Favourites need JavaScript turned on in your browser.</p></noscript>
</div>

{% schema %}
{
  "name": "Favourites",
  "settings": [
    { "type": "paragraph", "content": "Shows the pieces a visitor has saved with the heart. Favourites are kept in the visitor's browser on that device; no account is needed." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Soft Hours" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Favourites" },
    { "type": "text", "id": "intro", "label": "Introduction", "default": "The pieces you have saved, kept on this device." },
    { "type": "text", "id": "empty_heading", "label": "Empty heading", "default": "Nothing saved yet" },
    { "type": "text", "id": "empty_body", "label": "Empty message", "default": "Tap the heart on any piece to keep it here." },
    { "type": "text", "id": "empty_link_label", "label": "Empty link label", "default": "Shop Collection I" },
    { "type": "url", "id": "empty_link", "label": "Empty link" }
  ]
}
{% endschema %}
