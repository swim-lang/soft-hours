<header class="page-hero"><p class="eyebrow">Support</p><h1>{{ page.title | default: 'Contact' }}</h1></header>
<section class="page-shell support-layout">
  <div class="contact-form">
    {% form 'contact' %}
      {% if form.posted_successfully? %}<p class="form-status">Thank you. We will be in touch.</p>{% endif %}
      {% if form.errors %}<div class="form-status">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="field"><label for="ContactName">Name</label><input id="ContactName" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name"></div>
      <div class="field"><label for="ContactEmail">Email</label><input id="ContactEmail" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required></div>
      <div class="field"><label for="ContactOrder">Order number <span>(optional)</span></label><input id="ContactOrder" type="text" name="contact[order_number]"></div>
      <div class="field"><label for="ContactMessage">Message</label><textarea id="ContactMessage" name="contact[body]" required>{{ form.body }}</textarea></div>
      <button class="button button--dark" type="submit">Send message</button>
    {% endform %}
  </div>
  <aside>
    <p class="eyebrow">Contact</p>
    <h2 class="display">A NOTE TO SOFT HOURS</h2>
    {% if section.settings.body != blank %}<div class="rte">{{ section.settings.body }}</div>{% endif %}
    {% if settings.support_email != blank %}<a class="text-link" href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a>{% endif %}
  </aside>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [{ "type": "richtext", "id": "body", "label": "Intro", "default": "<p>For product, fit, or order questions, send us a note.</p>" }]
}
{% endschema %}
