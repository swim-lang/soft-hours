<header class="page-hero"><p class="eyebrow">Customer account</p><h1>Welcome, {{ customer.first_name | default: customer.name }}</h1></header>
<section class="page-shell support-layout">
  <div>
    <h2 class="display">Order History</h2>
    {% paginate customer.orders by 12 %}
      {% if customer.orders.size > 0 %}
        <div class="account-orders">
          {% for order in customer.orders %}<a href="{{ order.customer_url }}"><span>{{ order.name }}</span><span>{{ order.created_at | date: '%d.%m.%y' }}</span><span>{{ order.financial_status_label }}</span><span>{{ order.total_net_amount | money }}</span></a>{% endfor %}
        </div>
      {% else %}
        <div class="empty-state"><p>No orders yet.</p><a class="text-link" href="{{ routes.all_products_collection_url }}">View Collection I</a></div>
      {% endif %}
      {% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}
    {% endpaginate %}
  </div>
  <aside><p class="eyebrow">Account</p><div class="rte">{{ customer.default_address | format_address }}</div><p><a class="text-link" href="{{ routes.account_addresses_url }}">Manage addresses</a></p><p><a class="text-link" href="{{ routes.account_logout_url }}">Sign out</a></p></aside>
</section>

{% schema %}{ "name": "Account", "settings": [] }{% endschema %}
