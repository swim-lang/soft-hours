<section class="home-edit"{% if section.settings.image %} style="background-image:url({{ section.settings.image | image_url: width: 2200 }})"{% else %} style="background-image:url({{ '01KV8M6QDDQ6C7P21WFFWKVW6D.jpg' | asset_url }})"{% endif %}>
  <div class="home-edit-scrim"></div>
  <div class="home-edit-label"><span class="line"></span><span>{{ section.settings.eyebrow }}</span><span class="line"></span></div>
  <h2 class="home-edit-title">{{ section.settings.heading }}</h2>
</section>
{% schema %}
{
  "name": "Collection editorial",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collection I" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "HOURS WORTH DRESSING FOR" }
  ],
  "presets": [{ "name": "Collection editorial" }]
}
{% endschema %}
