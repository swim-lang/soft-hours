{% liquid
  assign current_variant = product.selected_or_first_available_variant
%}
<section class="product-main" data-product-root>
  <div class="product-gallery" aria-label="Product images">
    {% for media in product.media %}
      <div class="product-gallery__item">
        {% case media.media_type %}
          {% when 'image' %}{{ media | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '480, 750, 1000, 1400, 1800', sizes: '(min-width: 901px) 60vw, 100vw', alt: media.alt | default: product.title }}
          {% else %}{{ media | media_tag }}
        {% endcase %}
      </div>
    {% else %}
      <div class="product-gallery__item">{{ 'product-1' | placeholder_svg_tag }}</div>
    {% endfor %}
  </div>

  <div class="product-panel">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ product.title }}</h1>
    <div class="product-price" data-product-price>{{ current_variant.price | money }}</div>
    {% if product.metafields.custom.short_description != blank %}<div class="product-description rte">{{ product.metafields.custom.short_description | metafield_tag }}</div>{% elsif product.description != blank %}<div class="product-description rte">{{ product.description }}</div>{% endif %}

    <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="product-form" data-product-form>
      <input type="hidden" name="id" value="{{ current_variant.id }}">
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="product-form__row">
            <label for="Option-{{ section.id }}-{{ forloop.index }}">
              <span>{{ option.name }}</span>
              {% if option.name == 'Size' and section.settings.size_guide_url != blank %}<a class="text-link" href="{{ section.settings.size_guide_url }}">Size Guide</a>{% endif %}
            </label>
            <select id="Option-{{ section.id }}-{{ forloop.index }}" data-option-select>
              {% for value in option.values %}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>{% endfor %}
            </select>
          </div>
        {% endfor %}
      {% endunless %}

      <div data-purchase-panel{% unless current_variant.available %} hidden{% endunless %}>
        <button class="button button--dark button--full" type="submit" data-add-to-cart>Add to Cart</button>
      </div>
      <p class="form-status" role="status" aria-live="polite" data-product-status></p>
    </form>

    <div data-notify-panel{% if current_variant.available %} hidden{% endif %}>
      <p class="eyebrow">This selection is currently unavailable.</p>
      {% form 'customer', class: 'notify-form' %}
        <input type="hidden" name="contact[tags]" value="notify-me,{{ product.handle }}">
        <div class="newsletter-form">
          <label class="visually-hidden" for="NotifyEmail-{{ section.id }}">Email address</label>
          <input id="NotifyEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="Email address" required>
          <button type="submit">Notify me →</button>
        </div>
        {% if form.posted_successfully? %}<p class="form-status">We will keep you informed.</p>{% endif %}
        {% if form.errors %}<div class="form-status">{{ form.errors | default_errors }}</div>{% endif %}
      {% endform %}
    </div>

    <script type="application/json" data-variants>[
      {% for variant in product.variants %}{"id":{{ variant.id }},"available":{{ variant.available | json }},"options":{{ variant.options | json }},"price":{{ variant.price | money | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}
    ]</script>

    <div class="product-accordions">
      {% if product.metafields.custom.details != blank or product.metafields.custom.maker_story != blank or product.description != blank %}<details><summary>Details</summary><div class="rte">{% if product.metafields.custom.details != blank %}{{ product.metafields.custom.details | metafield_tag }}{% elsif product.description != blank %}{{ product.description }}{% endif %}{% if product.metafields.custom.maker_story != blank %}{{ product.metafields.custom.maker_story | metafield_tag }}{% endif %}</div></details>{% endif %}
      {% if product.metafields.custom.fit_notes != blank or product.metafields.custom.size_guide != blank or product.metafields.custom.model_information != blank %}<details><summary>Fit & Measurements</summary><div class="rte">{% if product.metafields.custom.fit_notes != blank %}{{ product.metafields.custom.fit_notes | metafield_tag }}{% endif %}{% if product.metafields.custom.size_guide != blank %}{{ product.metafields.custom.size_guide | metafield_tag }}{% endif %}{% if product.metafields.custom.model_information != blank %}{{ product.metafields.custom.model_information | metafield_tag }}{% endif %}</div></details>{% endif %}
      {% if product.metafields.custom.fabric_composition != blank or product.metafields.custom.care_instructions != blank %}<details><summary>Fabric & Care</summary><div class="rte">{% if product.metafields.custom.fabric_composition != blank %}{{ product.metafields.custom.fabric_composition | metafield_tag }}{% endif %}{% if product.metafields.custom.care_instructions != blank %}{{ product.metafields.custom.care_instructions | metafield_tag }}{% endif %}</div></details>{% endif %}
      {% if product.metafields.custom.delivery_returns_summary != blank or product.metafields.custom.dispatch_estimate != blank %}<details><summary>Delivery & Returns</summary><div class="rte">{% if product.metafields.custom.dispatch_estimate != blank %}{{ product.metafields.custom.dispatch_estimate | metafield_tag }}{% endif %}{% if product.metafields.custom.delivery_returns_summary != blank %}{{ product.metafields.custom.delivery_returns_summary | metafield_tag }}{% endif %}</div></details>{% endif %}
    </div>
  </div>
</section>

{% assign related_products = product.metafields.custom.related_products.value %}
{% if related_products != blank %}
  <section class="product-related page-width">
    <div class="section-heading">
      <p class="eyebrow">{{ section.settings.related_eyebrow }}</p>
      <h2>{{ section.settings.related_heading }}</h2>
    </div>
    <div class="product-grid">
      {% for related_product in related_products limit: 3 %}
        {% render 'product-card', product: related_product %}
      {% endfor %}
    </div>
  </section>
{% endif %}

<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "paragraph", "content": "Product name, gallery, price, variants, and description are edited in Products. Fit, model, maker, fabric, care, dispatch, delivery, and related-product fields use the custom product metafields listed in the editor guide. Blank fields stay hidden." },
    { "type": "text", "id": "eyebrow", "label": "Product eyebrow", "default": "Collection I" },
    { "type": "url", "id": "size_guide_url", "label": "Size Guide link" },
    { "type": "header", "content": "Related products" },
    { "type": "text", "id": "related_eyebrow", "label": "Eyebrow", "default": "Complete the set" },
    { "type": "text", "id": "related_heading", "label": "Heading", "default": "Made to be worn together." }
  ]
}
{% endschema %}
