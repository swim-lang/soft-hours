{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign fallback_primary = '01KV6816HE9450H72167DYES51.png'
  assign fallback_secondary = '01KV8PJTD4ZHJEREKVFKW4WWMZ.jpg'
  assign fallback_third = '01KV8PYRHCSVV1QXRGET4FSMV8.jpg'
  assign fallback_position = '50% 32%'
  case product.handle
    when 'shorts'
      assign fallback_primary = '01KV680CPDKSC4FCTPKY900JK6.png'
      assign fallback_secondary = '01KV67Y135HYV9811QS1KQV6J7.png'
      assign fallback_third = '01KV681D1WG30XPDZFP0QJ9CEB.jpg'
      assign fallback_position = '50% 30%'
    when 'button-down-shirt'
      assign fallback_primary = '01KV68456NW8SJZP5R6X551XAH.png'
      assign fallback_secondary = '01KV67YDSB1SS5XY3DYD75R8NX.png'
      assign fallback_third = '01KV8PYRHCSVV1QXRGET4FSMV8.jpg'
      assign fallback_position = '50% 20%'
    when 'long-pants'
      assign fallback_primary = '73NVMYR3STMMM9P9G1RHKZ4ZC0.jpg'
      assign fallback_secondary = '01KV8PYRHCSVV1QXRGET4FSMV8.jpg'
      assign fallback_third = '01KV684H0VDRG3GVFXEF0EHZYG.jpg'
      assign fallback_position = '50% 24%'
    when 'dress'
      assign fallback_primary = '01KV684QM8FD71MTJ337JET3W2.jpg'
      assign fallback_secondary = '01KV8Q5YVKN4B291G463W18R4R.jpg'
      assign fallback_third = '01KV8M6QDDQ6C7P21WFFWKVW6D.jpg'
      assign fallback_position = '22% 55%'
  endcase
  if product.images[0]
    assign primary_url = product.images[0] | image_url: width: 1800
  else
    assign primary_url = fallback_primary | asset_url
  endif
  if product.images[1]
    assign secondary_url = product.images[1] | image_url: width: 1800
  else
    assign secondary_url = fallback_secondary | asset_url
  endif
  if product.images[2]
    assign third_url = product.images[2] | image_url: width: 1800
  else
    assign third_url = fallback_third | asset_url
  endif
%}

<div class="product-v2" data-product-root>
  <section class="pdp-hero">
    <div class="pdp-gallery" data-gallery data-reveal>
      <div class="pdp-main-img" data-gallery-main role="img" aria-label="{{ product.title | escape }}" style="background-image:url('{{ primary_url }}');background-position:{{ fallback_position }};"></div>
      <div class="pdp-thumbs" aria-label="Product gallery">
        <button class="pdp-thumb active" type="button" data-gallery-thumb="{{ primary_url }}" aria-label="View first product image" style="background-image:url('{{ primary_url }}');background-position:{{ fallback_position }};"></button>
        <button class="pdp-thumb" type="button" data-gallery-thumb="{{ secondary_url }}" aria-label="View second product image" style="background-image:url('{{ secondary_url }}');background-position:50% 30%;"></button>
        <button class="pdp-thumb" type="button" data-gallery-thumb="{{ third_url }}" aria-label="View third product image" style="background-image:url('{{ third_url }}');background-position:50% 40%;"></button>
      </div>
    </div>

    <div class="pdp-info" data-reveal>
      <div class="pdp-crumb"><a href="{{ routes.collections_url }}/collection-i">Shop</a><span>/</span><span class="current">{{ product.title }}</span></div>
      <h1 class="pdp-title">{{ product.title }}</h1>
      <div class="pdp-price" data-product-price>{{ current_variant.price | money_with_currency }}</div>
      <div class="pdp-desc">
        {% if product.metafields.custom.short_description != blank %}{{ product.metafields.custom.short_description | metafield_tag }}
        {% elsif product.description != blank %}{{ product.description }}
        {% else %}<p>{{ section.settings.fallback_description }}</p>{% endif %}
      </div>
      <div class="pdp-rule"></div>

      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" data-product-form>
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            {% assign option_index = forloop.index0 %}
            {% if option.name == 'Color' or option.name == 'Colour' %}
              <div class="pdp-colour">
                <div class="pdp-opt-label">{{ option.name }} — <span data-option-label="{{ option_index }}">{{ option.selected_value }}</span></div>
                <div class="pdp-swatches">
                  {% for value in option.values %}
                    {% assign colour_image = primary_url %}
                    {% case forloop.index %}
                      {% when 2 %}{% assign colour_image = secondary_url %}
                      {% when 3 %}{% assign colour_image = third_url %}
                      {% when 4 %}{% assign colour_image = secondary_url %}
                    {% endcase %}
                    <button type="button" class="pdp-swatch" data-option-button data-option-index="{{ option_index }}" data-option-value="{{ value | escape }}" data-colour-image="{{ colour_image }}" aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}" aria-label="{{ value | escape }}" style="{% case value | handle %}{% when 'pine-grove' %}background:#2F4A3B{% when 'eggplant' %}background:#563747{% when 'burnished-lilac' %}background:#A77F86{% when 'oat-milk' %}background:#E3D8C2{% else %}background:#D7C8B0{% endcase %}"></button>
                  {% endfor %}
                </div>
                <p class="pdp-colour-note" aria-live="polite">Select a colour to preview its imagery.</p>
              </div>
            {% elsif option.name == 'Size' %}
              <div class="pdp-size">
                <div class="pdp-size-head"><span class="pdp-opt-label">Size <span class="visually-hidden">selected:</span> <span data-option-label="{{ option_index }}">{{ option.selected_value }}</span></span><button type="button" class="pdp-size-guide" data-open-size-guide>Size Guide</button></div>
                <div class="pdp-sizes">
                  {% for value in option.values %}<button type="button" class="pdp-size-opt" data-option-button data-option-index="{{ option_index }}" data-option-value="{{ value | escape }}" aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}">{{ value }}</button>{% endfor %}
                </div>
              </div>
            {% else %}
              <div class="pdp-size"><label class="pdp-opt-label" for="Option-{{ section.id }}-{{ option_index }}">{{ option.name }}</label><select id="Option-{{ section.id }}-{{ option_index }}" data-option-select data-option-index="{{ option_index }}">{% for value in option.values %}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>{% endfor %}</select></div>
            {% endif %}
            {% unless option.name != 'Color' and option.name != 'Colour' and option.name != 'Size' %}
              <select class="visually-hidden" aria-hidden="true" tabindex="-1" data-option-select data-option-index="{{ option_index }}">{% for value in option.values %}<option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>{% endfor %}</select>
            {% endunless %}
          {% endfor %}
        {% endunless %}

        <div data-purchase-panel{% unless current_variant.available %} hidden{% endunless %}>
          <button class="pdp-add" type="submit" data-add-to-cart>Add to Cart — {{ current_variant.price | money_with_currency }}</button>
        </div>
        <p class="prototype-status" role="status" aria-live="polite" data-product-status></p>
      </form>

      <div data-notify-panel{% if current_variant.available %} hidden{% endif %}>
        <p class="pdp-sold-out">Sold out</p>
        {% form 'customer', class: 'pdp-notify' %}
          <input type="hidden" name="contact[tags]" value="notify-me,{{ product.handle }}">
          <label for="NotifyEmail-{{ section.id }}">Email address</label>
          <div><input id="NotifyEmail-{{ section.id }}" type="email" name="contact[email]" required placeholder="your.name@example.com"><button type="submit">Notify me</button></div>
          {% if form.posted_successfully? %}<p class="prototype-status">We will keep you informed.</p>{% endif %}
          {% if form.errors %}<div class="prototype-status">{{ form.errors | default_errors }}</div>{% endif %}
        {% endform %}
      </div>

      <script type="application/json" data-variants>[
        {% for variant in product.variants %}{"id":{{ variant.id }},"available":{{ variant.available | json }},"options":{{ variant.options | json }},"price":{{ variant.price | money_with_currency | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}
      ]</script>

      <p class="pdp-ship-note">{{ product.metafields.custom.delivery_returns_summary | default: section.settings.delivery_placeholder }}</p>

      <div class="pdp-accordion">
        <div class="pdp-acc-row"><button class="pdp-acc-button" type="button" data-accordion-button aria-expanded="false" aria-controls="ProductDetails-{{ section.id }}"><span>Details</span><span data-accordion-icon>+</span></button><div class="pdp-acc-content" id="ProductDetails-{{ section.id }}" hidden>{% if product.metafields.custom.details != blank %}{{ product.metafields.custom.details | metafield_tag }}{% elsif product.metafields.custom.maker_story != blank %}{{ product.metafields.custom.maker_story | metafield_tag }}{% else %}{{ section.settings.details_placeholder }}{% endif %}</div></div>
        <div class="pdp-acc-row"><button class="pdp-acc-button" type="button" data-accordion-button aria-expanded="false" aria-controls="ProductFit-{{ section.id }}"><span>Fit &amp; Measurements</span><span data-accordion-icon>+</span></button><div class="pdp-acc-content pdp-fit-content" id="ProductFit-{{ section.id }}" hidden><div class="pdp-fit-visual"><img src="{{ 'fit-measurement-guide.svg' | asset_url }}" alt="Illustrative body measurement guide showing bust, waist, hip, and garment length positions" width="520" height="760"></div><div class="pdp-fit-copy">{% if product.metafields.custom.fit_notes != blank %}{{ product.metafields.custom.fit_notes | metafield_tag }}{% else %}<p>Current development sizing is XS–XL, while the first run may be simplified to S/M/L.</p>{% endif %}<p class="pdp-fit-kicker">Illustrative body measurements · cm</p><dl class="pdp-fit-sample"><div><dt>01 · Bust</dt><dd>88</dd></div><div><dt>02 · Waist</dt><dd>70</dd></div><div><dt>03 · Hip</dt><dd>96</dd></div><div><dt>04 · Length</dt><dd>68</dd></div></dl><p class="pdp-fit-placeholder">Visual preview only. Final garment measurements and fit guidance will replace these sample values after approval.</p><button type="button" class="text-link" data-open-size-guide>View Size Guide →</button></div></div></div>
        <div class="pdp-acc-row"><button class="pdp-acc-button" type="button" data-accordion-button aria-expanded="false" aria-controls="ProductFabric-{{ section.id }}"><span>Fabric &amp; Care</span><span data-accordion-icon>+</span></button><div class="pdp-acc-content" id="ProductFabric-{{ section.id }}" hidden>{% if product.metafields.custom.fabric_composition != blank %}{{ product.metafields.custom.fabric_composition | metafield_tag }}{% else %}{{ section.settings.fabric_placeholder }}{% endif %}{% if product.metafields.custom.care_instructions != blank %}{{ product.metafields.custom.care_instructions | metafield_tag }}{% endif %}</div></div>
        <div class="pdp-acc-row"><button class="pdp-acc-button" type="button" data-accordion-button aria-expanded="false" aria-controls="ProductDelivery-{{ section.id }}"><span>Delivery &amp; Returns</span><span data-accordion-icon>+</span></button><div class="pdp-acc-content" id="ProductDelivery-{{ section.id }}" hidden>{% if product.metafields.custom.dispatch_estimate != blank %}{{ product.metafields.custom.dispatch_estimate | metafield_tag }}{% endif %}{% if product.metafields.custom.delivery_returns_summary != blank %}{{ product.metafields.custom.delivery_returns_summary | metafield_tag }}{% else %}{{ section.settings.delivery_placeholder }}{% endif %}</div></div>
      </div>
    </div>
  </section>

  {% assign related_products = product.metafields.custom.related_products.value %}
  {% assign collection_products = collections['collection-i'].products %}
  <section class="pdp-related" data-reveal>
    <div class="pdp-related-head"><h2 class="pdp-related-title">{{ section.settings.related_heading }}</h2><a href="{{ routes.collections_url }}/collection-i" class="pdp-view-all">Shop all →</a></div>
    <div class="pdp-related-grid">
      {% if related_products != blank %}
        {% for related_product in related_products limit: 3 %}{% render 'product-card', product: related_product %}{% endfor %}
      {% else %}
        {% assign related_count = 0 %}{% for related_product in collection_products %}{% unless related_product.id == product.id %}{% if related_count < 3 %}{% render 'product-card', product: related_product %}{% assign related_count = related_count | plus: 1 %}{% endif %}{% endunless %}{% endfor %}
      {% endif %}
    </div>
  </section>
  <section class="product-editorial"><h2>{{ section.settings.editorial_heading }}</h2></section>

  <dialog class="size-guide-dialog" data-size-guide-dialog aria-labelledby="SizeGuideTitle-{{ section.id }}">
    <div class="size-guide-dialog__head"><h2 id="SizeGuideTitle-{{ section.id }}">Size Guide</h2><button type="button" data-close-size-guide>Close ×</button></div>
    <div class="size-guide-dialog__body"><img src="{{ 'fit-measurement-guide.svg' | asset_url }}" alt="Illustrative body measurement guide" width="520" height="760"><div>{% if product.metafields.custom.size_guide != blank %}{{ product.metafields.custom.size_guide | metafield_tag }}{% else %}<p>Final garment measurements and fit guidance are being prepared. The sample chart shown here is for layout review only.</p><table><thead><tr><th>Size</th><th>Bust</th><th>Waist</th><th>Hip</th></tr></thead><tbody><tr><td>S</td><td>88</td><td>70</td><td>96</td></tr><tr><td>M</td><td>92</td><td>74</td><td>100</td></tr><tr><td>L</td><td>96</td><td>78</td><td>104</td></tr></tbody></table>{% endif %}</div></div>
  </dialog>
</div>

<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "paragraph", "content": "Product name, gallery, price, variants, and description are edited in Products. Fit, size guide, maker, fabric, care, dispatch, delivery, and related products use product metafields. Placeholders remain visible until final facts are approved." },
    { "type": "textarea", "id": "fallback_description", "label": "Fallback short description", "default": "A fluid layer for the first hour, the final hour, and the quieter moments between." },
    { "type": "textarea", "id": "details_placeholder", "label": "Details placeholder", "default": "Sampling is still in progress. Final construction details, model information, and colour names will remain editable until approved." },
    { "type": "textarea", "id": "fabric_placeholder", "label": "Fabric and care placeholder", "default": "Double-satin silk/modal blend. Final composition and care instructions remain subject to sampling and approval." },
    { "type": "textarea", "id": "delivery_placeholder", "label": "Delivery and returns placeholder", "default": "Delivery and returns details to be confirmed." },
    { "type": "text", "id": "related_heading", "label": "Related-products heading", "default": "Complete the set" },
    { "type": "text", "id": "editorial_heading", "label": "Editorial heading", "default": "For the First Hour and the Last" }
  ]
}
{% endschema %}
