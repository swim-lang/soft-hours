<footer class="site-footer" id="Newsletter">
  <div class="site-footer__links">
    <div>
      {% if section.settings.shop_menu != blank %}
        {% for link in section.settings.shop_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
      {% else %}
        <a href="{{ routes.all_products_collection_url }}">Shop</a><a href="/products/soft-hours-gift-card">Gift Card</a><a href="/pages/size-guide">Size Guide</a>
      {% endif %}
    </div>
    <div>
      {% if section.settings.brand_menu != blank %}
        {% for link in section.settings.brand_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
      {% else %}
        <a href="/pages/about">About</a><a href="/blogs/journal">Journal</a><a href="#NewsletterSignup">Newsletter</a><a href="/pages/contact-1">Contact</a>
      {% endif %}
    </div>
    <div>
      {% if section.settings.help_menu != blank %}
        {% for link in section.settings.help_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
      {% else %}
        <a href="/pages/faqs">FAQ</a><a href="/pages/shipping-returns">Delivery & Returns</a><a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy</a><a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms</a>
      {% endif %}
    </div>
    <div class="site-footer__social">
      {% if settings.instagram_url != blank %}<a href="{{ settings.instagram_url }}" rel="noopener" target="_blank">Instagram</a>{% endif %}
    </div>
  </div>

  <div class="site-footer__bottom">
    <a href="{{ routes.root_url }}">{{ settings.brand_name | default: shop.name }}</a>
    <span>{{ settings.footer_year }}</span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "paragraph", "content": "Manage link names and destinations in Content > Menus, then select the three footer menus here." },
    { "type": "link_list", "id": "shop_menu", "label": "Shop column" },
    { "type": "link_list", "id": "brand_menu", "label": "Soft Hours column" },
    { "type": "link_list", "id": "help_menu", "label": "Help column" }
  ]
}
{% endschema %}
