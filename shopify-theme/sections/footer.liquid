<footer class="footer" id="FooterNewsletter">
  <div class="footer-top"><div class="footer-cols">
    <div class="footer-col"><h4>Shop</h4><ul>
      {% if section.settings.shop_menu != blank %}{% for link in section.settings.shop_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
      {% else %}<li><a href="{{ routes.collections_url }}/collection-i">Collection I</a></li>{% if all_products['soft-hours-gift-card'] != blank %}<li><a href="{{ all_products['soft-hours-gift-card'].url }}">Gift Card</a></li>{% endif %}<li><a href="{{ section.settings.size_guide_review_url }}">Size Guide</a></li>{% endif %}
    </ul></div>
    <div class="footer-col"><h4>Soft Hours</h4><ul>
      {% if section.settings.brand_menu != blank %}{% for link in section.settings.brand_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
      {% else %}<li><a href="{{ section.settings.about_review_url }}">About</a></li><li><a href="{{ blogs['journal'].url | default: routes.root_url }}">Journal</a></li><li><a href="{{ routes.root_url }}#NewsletterSignup">Newsletter</a></li><li><a href="{{ routes.root_url }}pages/contact-1">Contact</a></li>{% endif %}
    </ul></div>
    <div class="footer-col"><h4>Help</h4><ul>
      {% if section.settings.help_menu != blank %}{% for link in section.settings.help_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
      {% else %}<li><a href="{{ routes.root_url }}pages/faqs">FAQ</a></li><li><a href="{{ routes.root_url }}pages/shipping-returns">Delivery & Returns</a></li>{% if shop.privacy_policy.url != blank %}<li><a href="{{ shop.privacy_policy.url }}">Privacy</a></li>{% endif %}{% if shop.terms_of_service.url != blank %}<li><a href="{{ shop.terms_of_service.url }}">Terms</a></li>{% endif %}{% endif %}
    </ul></div>
    <div class="footer-col"><h4>Follow</h4><ul>{% if settings.instagram_url != blank %}<li><a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">Instagram · @softhours</a></li>{% endif %}</ul></div>
  </div></div>
  <div class="footer-wordmark-band"><a class="footer-wordmark" href="{{ routes.root_url }}" aria-label="Soft Hours"></a></div>
  <div class="footer-bottom">
    <span>© Soft Hours · {{ settings.footer_year }}</span>
    <div class="footer-meta"><span>{{ localization.language.iso_code | upcase }}</span><span class="divider"></span><span>{{ localization.country.currency.iso_code }}</span></div>
    <span>{% if shop.privacy_policy.url != blank %}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{% endif %}{% if shop.privacy_policy.url != blank and shop.terms_of_service.url != blank %} · {% endif %}{% if shop.terms_of_service.url != blank %}<a href="{{ shop.terms_of_service.url }}">Terms</a>{% endif %}</span>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "paragraph", "content": "The approved oversized wordmark footer is fixed. Manage links in Content > Menus." },
    { "type": "link_list", "id": "shop_menu", "label": "Shop column" },
    { "type": "link_list", "id": "brand_menu", "label": "Soft Hours column" },
    { "type": "link_list", "id": "help_menu", "label": "Help column" },
    { "type": "text", "id": "about_review_url", "label": "About link", "default": "/pages/contact-1?view=about-review", "info": "Staging route while the About page is unpublished. Change to /pages/about before launch." },
    { "type": "text", "id": "size_guide_review_url", "label": "Size Guide link", "default": "/pages/contact-1?view=size-guide-review", "info": "Staging route while the Size Guide page is unpublished. Change to /pages/size-guide before launch." }
  ]
}
{% endschema %}
