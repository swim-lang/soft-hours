<header class="page-hero">
  <p class="eyebrow">Fit & Measurements</p>
  <h1>{{ page.title | default: 'Size Guide' }}</h1>
</header>
<section class="page-shell support-layout">
  <div>
    {% if section.blocks.size > 0 %}
      <div class="size-table" role="table" aria-label="Body measurements">
        <div class="size-table__row size-table__head" role="row"><span role="columnheader">Size</span><span role="columnheader">Bust</span><span role="columnheader">Waist</span><span role="columnheader">Hip</span></div>
        {% for block in section.blocks %}<div class="size-table__row" role="row" {{ block.shopify_attributes }}><strong role="cell">{{ block.settings.size }}</strong><span role="cell">{{ block.settings.bust }}</span><span role="cell">{{ block.settings.waist }}</span><span role="cell">{{ block.settings.hip }}</span></div>{% endfor %}
      </div>
    {% else %}
      <p class="rte">The final size range and garment measurements will appear here once sampling is complete.</p>
    {% endif %}
  </div>
  <aside>
    <p class="eyebrow">How to measure</p>
    <h2 class="display">A SIMPLE GUIDE</h2>
    <div class="rte">{{ section.settings.instructions }}</div>
    {% if section.settings.contact_url != blank %}<a class="text-link" href="{{ section.settings.contact_url }}">Need help? Contact us</a>{% endif %}
  </aside>
</section>

{% schema %}
{
  "name": "Size Guide",
  "settings": [
    { "type": "richtext", "id": "instructions", "label": "How to measure", "default": "<p><strong>Bust</strong><br>Measure around the fullest part.</p><p><strong>Waist</strong><br>Measure around the natural waist.</p><p><strong>Hip</strong><br>Measure around the fullest part of the hips.</p>" },
    { "type": "url", "id": "contact_url", "label": "Contact link" }
  ],
  "blocks": [
    { "type": "size", "name": "Size", "settings": [
      { "type": "text", "id": "size", "label": "Size" },
      { "type": "text", "id": "bust", "label": "Bust" },
      { "type": "text", "id": "waist", "label": "Waist" },
      { "type": "text", "id": "hip", "label": "Hip" }
    ] }
  ],
  "presets": [{ "name": "Size Guide" }]
}
{% endschema %}
