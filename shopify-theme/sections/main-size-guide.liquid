<header class="page-hero">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h1>{{ section.settings.page_heading }}</h1>
</header>
<section class="page-shell support-layout">
  <div>
    {% if section.settings.image %}<div class="size-guide__visual">{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 750, 1000, 1400', sizes: '(min-width: 901px) 760px, 100vw', alt: section.settings.image_alt | default: section.settings.image.alt | default: page.title }}</div>{% endif %}
    {% if section.blocks.size > 0 %}
      <div class="size-table" role="table" aria-label="Body measurements">
        <div class="size-table__row size-table__head" role="row"><span role="columnheader">Size</span><span role="columnheader">Bust</span><span role="columnheader">Waist</span><span role="columnheader">Hip</span></div>
        {% for block in section.blocks %}<div class="size-table__row" role="row" {{ block.shopify_attributes }}><strong role="cell">{{ block.settings.size }}</strong><span role="cell">{{ block.settings.bust }}</span><span role="cell">{{ block.settings.waist }}</span><span role="cell">{{ block.settings.hip }}</span></div>{% endfor %}
      </div>
    {% else %}
      <p class="rte">{{ section.settings.empty_message }}</p>
    {% endif %}
  </div>
  <aside>
    <p class="eyebrow">{{ section.settings.instructions_eyebrow }}</p>
    <h2 class="display">{{ section.settings.instructions_heading }}</h2>
    <div class="rte">{{ section.settings.instructions }}</div>
    {% if section.settings.contact_url != blank %}<a class="text-link" href="{{ section.settings.contact_url }}">Need help? Contact us</a>{% endif %}
  </aside>
</section>

{% schema %}
{
  "name": "Size Guide",
  "settings": [
    { "type": "paragraph", "content": "Use the blocks below for approved measurements. Values are plain text so Marion can include cm or inches exactly as needed." },
    { "type": "text", "id": "eyebrow", "label": "Page eyebrow", "default": "Fit & Measurements" },
    { "type": "text", "id": "page_heading", "label": "Page heading", "default": "Size Guide" },
    { "type": "image_picker", "id": "image", "label": "Measurement illustration" },
    { "type": "text", "id": "image_alt", "label": "Illustration description" },
    { "type": "text", "id": "empty_message", "label": "Message when no sizes exist", "default": "The final size range and garment measurements will appear here once sampling is complete." },
    { "type": "header", "content": "How to measure" },
    { "type": "text", "id": "instructions_eyebrow", "label": "Eyebrow", "default": "How to measure" },
    { "type": "text", "id": "instructions_heading", "label": "Heading", "default": "A Simple Guide" },
    { "type": "richtext", "id": "instructions", "label": "How to measure", "default": "<p><strong>Bust</strong><br>Measure around the fullest part.</p><p><strong>Waist</strong><br>Measure around the natural waist.</p><p><strong>Hip</strong><br>Measure around the fullest part of the hips.</p>" },
    { "type": "url", "id": "contact_url", "label": "Contact link" }
  ],
  "blocks": [
    { "type": "size", "name": "Size", "settings": [
      { "type": "text", "id": "size", "label": "Size" },
      { "type": "text", "id": "bust", "label": "Bust" },
      { "type": "text", "id": "waist", "label": "Waist" },
      { "type": "text", "id": "hip", "label": "Hip" }
    ], "limit": 8 }
  ],
  "presets": [{ "name": "Size Guide" }]
}
{% endschema %}
