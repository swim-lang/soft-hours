<section class="main-cart">
  <div class="main-cart__head">
    <h1>Cart</h1>
    <span>{{ cart.item_count }} items</span>
  </div>

  {% if cart.item_count == 0 %}
    <div class="empty-state"><p>Your cart is empty.</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Continue Shopping</a></div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post">
      {% for item in cart.items %}
        <article class="cart-line">
          <a class="cart-line__image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}</a>
          <div class="cart-line__details">
            <div class="cart-line__top"><a href="{{ item.url }}">{{ item.product.title }}</a><span>{{ item.final_line_price | money }}</span></div>
            {% unless item.product.has_only_default_variant %}<div class="cart-line__options">{{ item.options_with_values | map: 'value' | join: ' / ' }}</div>{% endunless %}
            <div class="cart-line__actions">
              <label class="visually-hidden" for="Quantity-{{ forloop.index }}">Quantity</label>
              <input id="Quantity-{{ forloop.index }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}">
              <a class="text-link" href="{{ item.url }}">Edit</a>
              <a class="text-link" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Remove</a>
            </div>
          </div>
        </article>
      {% endfor %}

      <div class="main-cart__summary">
        <div class="cart-summary"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
        {% if settings.cart_operational_note != blank %}<p class="cart-note">{{ settings.cart_operational_note }}</p>{% endif %}
        <button class="button button--full" type="submit" name="update">Update Cart</button>
        <button class="button button--dark button--full" type="submit" name="checkout">Checkout</button>
      </div>
    </form>
  {% endif %}
</section>

{% schema %}{ "name": "Cart", "settings": [] }{% endschema %}
