{% assign article_position = 1 %}
{% for journal_article in blog.articles %}
  {% if journal_article.handle == article.handle %}{% assign article_position = forloop.index %}{% endif %}
{% endfor %}

{% assign title_length = article.title | size %}
{% assign title_modifier = '' %}
{% if title_length > 84 %}
  {% assign title_modifier = ' article-title--xlong' %}
{% elsif title_length > 42 %}
  {% assign title_modifier = ' article-title--long' %}
{% endif %}

<main class="article-v2 journal-article-v2">
  <header class="article-header{% if title_modifier != blank %} article-header--long{% endif %}">
    <p class="page-eyebrow">{% render 'journal-meta', article: article, position: article_position %}</p>
    <h1 class="article-title{{ title_modifier }}">{{ article.title }}</h1>
    <p class="article-date">{{ article.published_at | date: '%d %B %Y' }} · {{ blog.title }}</p>
  </header>

  {% if article.image %}
    <figure>
      {{ article.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '750, 1080, 1400, 1800', sizes: '(min-width: 761px) 1080px, 100vw', alt: article.image.alt | default: article.title }}
    </figure>
  {% endif %}

  <div class="article-body">
    {% if article.content != blank %}
      {% if article.excerpt != blank %}<h2>{{ article.excerpt | strip_html }}</h2>{% endif %}
      <div class="article-content rte">{{ article.content }}</div>
    {% else %}
      <div class="article-placeholder" aria-label="Temporary article content">
        <h2>Silk, distance, and the long road toward something worth keeping.</h2>
        <p>This temporary editorial copy demonstrates the approved Journal reading experience. Replace it in Shopify when the complete story is ready.</p>
        <p>Body text, captions, credits, pull quotes, and publication details remain editable Shopify blog content.</p>
        <blockquote>“The day belongs to many things. Some hours remain your own.”</blockquote>
      </div>
    {% endif %}

    <div class="article-actions"><button type="button" data-share-article>Share</button><a href="{{ blog.url }}">Back to Journal</a></div>
  </div>

  {% assign next_note = blank %}
  {% assign current_found = false %}
  {% for journal_article in blog.articles %}
    {% if current_found and next_note == blank %}{% assign next_note = journal_article %}{% endif %}
    {% if journal_article.handle == article.handle %}{% assign current_found = true %}{% endif %}
  {% endfor %}
  {% if next_note == blank and blog.articles.size > 1 %}{% assign next_note = blog.articles.first %}{% endif %}

  {% if next_note != blank %}
    <a class="article-next" href="{{ next_note.url }}"><span><small>Next note</small><strong>{{ next_note.title }}</strong></span><span>Read next</span></a>
  {% else %}
    <a class="article-next" href="{{ blog.url }}"><span><small>Continue reading</small><strong>Journal</strong></span><span>View all notes</span></a>
  {% endif %}
</main>

{% schema %}{ "name": "Journal article", "settings": [] }{% endschema %}
