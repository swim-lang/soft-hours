<header class="page-hero"><p class="eyebrow">Customer account</p><h1>Account</h1></header>
<section class="page-shell support-layout">
  <div class="contact-form">
    <h2 class="display">WELCOME BACK</h2>
    {% form 'customer_login' %}
      {% if form.errors %}<div class="form-status">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="field"><label for="CustomerEmail">Email</label><input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required></div>
      <div class="field"><label for="CustomerPassword">Password</label><input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required></div>
      <button class="button button--dark" type="submit">Sign in</button>
    {% endform %}
  </div>
  <aside><p class="eyebrow">Your Soft Hours</p><div class="rte"><p>View orders and manage account details. Stores using Shopify's new customer accounts will route this entry to Shopify's passwordless account experience.</p></div></aside>
</section>

{% schema %}{ "name": "Account entry", "settings": [] }{% endschema %}
