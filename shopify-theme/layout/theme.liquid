<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="icon" type="image/png" sizes="96x96" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
      <link rel="icon" type="image/png" sizes="192x192" href="{{ settings.favicon | image_url: width: 192, height: 192 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}
    {%- if template.name == 'page' and template.suffix contains 'about' -%}<link rel="preload" as="image" href="{{ 'circle-1600.png' | asset_url }}" fetchpriority="high">{%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} — {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} — Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} — {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% render 'meta-tags' %}
    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'approved-base.css' | asset_url | stylesheet_tag }}
    {{ 'approved-v2.css' | asset_url | stylesheet_tag }}
    {{ 'revisions-ii.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.classList.remove('no-js'); document.documentElement.classList.add('js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="page template-{{ template.name | handle }}{% if settings.paper_shop_surfaces %} paper-shop-surfaces{% endif %}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'header' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    {% section 'cart-drawer-section' %}
    {% section 'cookie-banner' %}
    {% render 'search-drawer' %}
    {% render 'notify-dialog' %}
    <div class="page-overlay" data-overlay hidden></div>
  </body>
</html>
