<aside class="drawer cart-drawer" id="CartDrawer" aria-hidden="true" aria-labelledby="CartDrawerTitle" data-cart-drawer>
  <div class="drawer__head">
    <h2 id="CartDrawerTitle">Cart (<span data-cart-count>{{ cart.item_count }}</span>)</h2>
    <button class="button-reset" type="button" data-close-cart>Close ×</button>
  </div>

  <div class="cart-drawer__body" data-cart-drawer-body>
    {% if cart.item_count == 0 %}
      <div class="empty-state">
        <p>Your cart is empty.</p>
        <a class="text-link" href="{{ routes.all_products_collection_url }}">Continue Shopping</a>
      </div>
    {% else %}
      <div class="cart-lines">
        {% for item in cart.items %}
          <article class="cart-line" data-cart-line="{{ forloop.index }}">
            <a class="cart-line__image" href="{{ item.url }}">
              {% if item.image %}{{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', widths: '120, 240, 320', alt: item.product.title }}{% endif %}
            </a>
            <div class="cart-line__details">
              <div class="cart-line__top">
                <a href="{{ item.url }}">{{ item.product.title }}</a>
                <span>{{ item.final_line_price | money }}</span>
              </div>
              {% unless item.product.has_only_default_variant %}
                <dl class="cart-line__options">
                  {% for option in item.options_with_values %}<div><dt>{{ option.name }}:</dt><dd>{{ option.value }}</dd></div>{% endfor %}
                </dl>
              {% endunless %}
              <div class="cart-line__actions">
                <div class="quantity" aria-label="Quantity for {{ item.product.title }}">
                  <button type="button" aria-label="Decrease quantity" data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | minus: 1 }}">−</button>
                  <span aria-live="polite">{{ item.quantity }}</span>
                  <button type="button" aria-label="Increase quantity" data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | plus: 1 }}">+</button>
                </div>
                <a class="text-link" href="{{ item.url }}">Edit</a>
                <button class="button-reset text-link" type="button" data-cart-change data-line="{{ forloop.index }}" data-quantity="0">Remove</button>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {% if cart.item_count > 0 %}
    <div class="cart-drawer__footer">
      <div class="cart-summary"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
      {% if settings.cart_operational_note != blank %}<p class="cart-note">{{ settings.cart_operational_note }}</p>{% endif %}
      {% if settings.show_accelerated_checkout and additional_checkout_buttons %}
        <div class="accelerated-checkout">
          <span>Express checkout</span>
          <div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
        </div>
        <div class="cart-divider"><span>or</span></div>
      {% endif %}
      <form action="{{ routes.cart_url }}" method="post">
        <button class="button button--dark button--full" type="submit" name="checkout">Checkout</button>
      </form>
      <div class="cart-drawer__links">
        <button class="button-reset text-link" type="button" data-close-cart>Continue Shopping</button>
        <a class="text-link" href="{{ routes.cart_url }}">View full Cart</a>
      </div>
    </div>
  {% endif %}
  <p class="form-status" role="status" aria-live="polite" data-cart-status></p>
</aside>
