{% liquid
  assign card_product = product
  assign primary_image = card_product.featured_image
  assign secondary_image = card_product.images[1]
  assign fallback_primary = '01KV6816HE9450H72167DYES51.png'
  assign fallback_hover = '01KV8PJTD4ZHJEREKVFKW4WWMZ.jpg'
  assign fallback_position = '50% 32%'
  case card_product.handle
    when 'shorts'
      assign fallback_primary = '01KV680CPDKSC4FCTPKY900JK6.png'
      assign fallback_hover = '01KV67Y135HYV9811QS1KQV6J7.png'
      assign fallback_position = '50% 30%'
    when 'button-down-shirt'
      assign fallback_primary = '01KV68456NW8SJZP5R6X551XAH.png'
      assign fallback_hover = '01KV67YDSB1SS5XY3DYD75R8NX.png'
      assign fallback_position = '50% 20%'
    when 'long-pants'
      assign fallback_primary = '73NVMYR3STMMM9P9G1RHKZ4ZC0.jpg'
      assign fallback_hover = '01KV8PYRHCSVV1QXRGET4FSMV8.jpg'
      assign fallback_position = '50% 24%'
    when 'dress'
      assign fallback_primary = '01KV684QM8FD71MTJ337JET3W2.jpg'
      assign fallback_hover = '01KV8Q5YVKN4B291G463W18R4R.jpg'
      assign fallback_position = '22% 55%'
  endcase
  if primary_image
    assign primary_url = primary_image | image_url: width: 1200
  else
    assign primary_url = fallback_primary | asset_url
  endif
  if secondary_image
    assign hover_url = secondary_image | image_url: width: 1200
  else
    assign hover_url = fallback_hover | asset_url
  endif
  assign size_option = blank
  assign quick_colour = blank
  for option in card_product.options_with_values
    if option.name == 'Size'
      assign size_option = option
    endif
    if option.name == 'Color' or option.name == 'Colour'
      assign quick_colour = option.selected_value
    endif
  endfor
%}
<article class="shop-card" data-product-card data-product-handle="{{ card_product.handle }}" data-name="{{ card_product.title | escape }}" data-price="{{ card_product.price }}" data-colours="{% for option in card_product.options_with_values %}{% if option.name == 'Color' or option.name == 'Colour' %}{% for value in option.values %}{{ value | handle }} {% endfor %}{% endif %}{% endfor %}" data-sizes="{% for option in card_product.options_with_values %}{% if option.name == 'Size' %}{% for value in option.values %}{{ value | handle }} {% endfor %}{% endif %}{% endfor %}">
  <div class="shop-card-media">
    <a href="{{ card_product.url }}" class="shop-card-image-link" aria-label="View {{ card_product.title | escape }}"><div class="shop-card-img" role="img" aria-label="{{ primary_image.alt | default: card_product.title | escape }}" data-card-image data-primary-image="{{ primary_url }}" data-secondary-image="{{ hover_url }}" style="background-image:url('{{ primary_url }}');background-position:{{ fallback_position }};--hover-image:url('{{ hover_url }}');"></div></a>
    <button class="shop-card-wishlist" type="button" data-wishlist-toggle data-product-handle="{{ card_product.handle }}" aria-pressed="false" aria-label="Save {{ card_product.title | escape }} to wishlist"><span aria-hidden="true">♡</span></button>
    <div class="shop-card-arrows" aria-label="Browse product images"><button type="button" data-card-image-prev aria-label="Previous image">←</button><button type="button" data-card-image-next aria-label="Next image">→</button></div>
  </div>
  <div class="shop-card-info">
    <a href="{{ card_product.url }}" class="shop-card-link"><div class="shop-card-row"><h2 class="shop-card-name">{{ card_product.title }}</h2><span class="shop-card-price">{{ card_product.price | money_with_currency }}</span></div></a>
    <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="shop-card-quick" data-product-form data-quick-add-form>
      <input type="hidden" name="id" value="{% unless size_option != blank %}{{ card_product.selected_or_first_available_variant.id }}{% endunless %}" data-quick-variant>
      {% if size_option != blank %}<fieldset><legend>Select size</legend><div class="shop-card-sizes">
        {% for size_value in size_option.values %}{% assign size_variant = blank %}{% for variant in card_product.variants %}{% if variant.available and variant.options contains size_value and size_variant == blank %}{% if quick_colour == blank or variant.options contains quick_colour %}{% assign size_variant = variant %}{% endif %}{% endif %}{% endfor %}<button type="button" data-card-size data-variant-id="{{ size_variant.id }}"{% if size_variant == blank %} disabled{% endif %}>{{ size_value | replace: 'Small', 'S' | replace: 'Medium', 'M' | replace: 'Large', 'L' }}</button>{% endfor %}
      </div></fieldset>{% endif %}
      {% if quick_colour != blank %}<p class="shop-card-colour">Colour: {{ quick_colour }}</p>{% endif %}
      {% if card_product.available %}<button class="shop-card-add" type="submit"{% if size_option != blank %} disabled{% endif %}>Add to Cart</button>{% else %}<a class="shop-card-add" href="{{ card_product.url }}#Notify">Notify me</a>{% endif %}
      <p class="prototype-status" role="status" aria-live="polite" data-product-status></p>
    </form>
  </div>
</article>
